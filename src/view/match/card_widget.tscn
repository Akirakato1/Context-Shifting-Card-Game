[connection signal="item_selected" from="Face/FirstChoices/Context" to="." method="_on_first_context_selected"]
[connection signal="item_selected" from="Face/FirstChoices/Suit" to="." method="_on_first_suit_selected"]
[connection signal="item_selected" from="Face/SecondChoices/Context" to="." method="_on_second_context_selected"]
[connection signal="item_selected" from="Face/SecondChoices/Suit" to="." method="_on_second_suit_selected"]
