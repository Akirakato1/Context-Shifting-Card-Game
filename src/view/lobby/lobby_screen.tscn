[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://src/view/lobby/lobby_screen.gd" id="1_script"]
[ext_resource type="Theme" path="res://themes/placeholder_theme.tres" id="2_theme"]

[node name="LobbyScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_script")

[node name="Backdrop" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.035, 0.055, 0.078, 1)

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 48.0
offset_top = 34.0
offset_right = -48.0
offset_bottom = -34.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 18

[node name="Header" type="HBoxContainer" parent="Layout"]
layout_mode = 2

[node name="Title" type="Label" parent="Layout/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.96, 0.97, 1, 1)
theme_override_font_sizes/font_size = 36
text = "TABLE LOBBY"

[node name="RoomCode" type="Label" parent="Layout/Header"]
layout_mode = 2
theme_override_colors/font_color = Color(0.35, 0.78, 0.93, 1)
theme_override_font_sizes/font_size = 28
text = "ROOM  ------"

[node name="Body" type="HBoxContainer" parent="Layout"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 24

[node name="Roster" type="VBoxContainer" parent="Layout/Body"]
custom_minimum_size = Vector2(400, 0)
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12

[node name="Heading" type="Label" parent="Layout/Body/Roster"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "SEATS"

[node name="Counts" type="Label" parent="Layout/Body/Roster"]
layout_mode = 2
theme_override_colors/font_color = Color(0.68, 0.75, 0.83, 1)
text = "0 / 4 players   •   0 / 4 spectators"

[node name="Players" type="VBoxContainer" parent="Layout/Body/Roster"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 8

[node name="Hint" type="Label" parent="Layout/Body/Roster"]
layout_mode = 2
theme_override_colors/font_color = Color(0.68, 0.75, 0.83, 1)
text = "New players may join open seats during a match and enter next round."
autowrap_mode = 2

[node name="Settings" type="GridContainer" parent="Layout/Body"]
custom_minimum_size = Vector2(500, 0)
layout_mode = 2
size_flags_horizontal = 3
columns = 2

[node name="Heading" type="Label" parent="Layout/Body/Settings"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "MATCH SETTINGS"

[node name="HeadingSpacer" type="Control" parent="Layout/Body/Settings"]
layout_mode = 2

[node name="VictoryModeLabel" type="Label" parent="Layout/Body/Settings"]
layout_mode = 2
text = "Victory mode"

[node name="VictoryMode" type="OptionButton" parent="Layout/Body/Settings"]
layout_mode = 2

[node name="VictoryTargetLabel" type="Label" parent="Layout/Body/Settings"]
layout_mode = 2
text = "Victory target"

[node name="VictoryTarget" type="SpinBox" parent="Layout/Body/Settings"]
layout_mode = 2
min_value = 1.0
max_value = 999.0
value = 10.0

[node name="VisibilityLabel" type="Label" parent="Layout/Body/Settings"]
layout_mode = 2
text = "Replacement requests"

[node name="Visibility" type="OptionButton" parent="Layout/Body/Settings"]
layout_mode = 2

[node name="StartTimerLabel" type="Label" parent="Layout/Body/Settings"]
layout_mode = 2
text = "Start phase (seconds)"

[node name="StartTimer" type="SpinBox" parent="Layout/Body/Settings"]
layout_mode = 2
min_value = 2.0
max_value = 120.0
value = 5.0

[node name="MainTimerLabel" type="Label" parent="Layout/Body/Settings"]
layout_mode = 2
text = "Main phases (seconds)"

[node name="MainTimer" type="SpinBox" parent="Layout/Body/Settings"]
layout_mode = 2
min_value = 2.0
max_value = 180.0
value = 5.0

[node name="HandTimerLabel" type="Label" parent="Layout/Body/Settings"]
layout_mode = 2
text = "Hand play (seconds)"

[node name="HandTimer" type="SpinBox" parent="Layout/Body/Settings"]
layout_mode = 2
min_value = 5.0
max_value = 300.0
value = 15.0

[node name="EndTimerLabel" type="Label" parent="Layout/Body/Settings"]
layout_mode = 2
text = "End discard (seconds)"

[node name="EndTimer" type="SpinBox" parent="Layout/Body/Settings"]
layout_mode = 2
min_value = 1.0
max_value = 60.0
value = 3.0

[node name="ReconnectTimerLabel" type="Label" parent="Layout/Body/Settings"]
layout_mode = 2
text = "Reconnect grace (seconds)"

[node name="ReconnectTimer" type="SpinBox" parent="Layout/Body/Settings"]
layout_mode = 2
min_value = 5.0
max_value = 120.0
value = 30.0

[node name="StatusPanel" type="VBoxContainer" parent="Layout"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Status" type="Label" parent="Layout/StatusPanel"]
layout_mode = 2
theme_override_colors/font_color = Color(0.65, 0.84, 0.77, 1)
text = "Room ready. Share the code when everyone is seated."
horizontal_alignment = 1
autowrap_mode = 2

[node name="RetryButton" type="Button" parent="Layout/StatusPanel"]
visible = false
layout_mode = 2
text = "TRY AGAIN"

[node name="DetailsButton" type="Button" parent="Layout/StatusPanel"]
layout_mode = 2
text = "Connection details"
flat = true

[node name="ConnectionDetails" type="RichTextLabel" parent="Layout/StatusPanel"]
visible = false
custom_minimum_size = Vector2(0, 58)
layout_mode = 2
bbcode_enabled = true
text = "[center]Direct connection status and diagnostic messages appear here.[/center]"
fit_content = true

[node name="Footer" type="HBoxContainer" parent="Layout"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="LeaveButton" type="Button" parent="Layout/Footer"]
custom_minimum_size = Vector2(160, 48)
layout_mode = 2
text = "LEAVE"

[node name="FooterSpacer" type="Control" parent="Layout/Footer"]
layout_mode = 2
size_flags_horizontal = 3

[node name="ReadyButton" type="CheckButton" parent="Layout/Footer"]
custom_minimum_size = Vector2(160, 48)
layout_mode = 2
text = "READY"

[node name="StartButton" type="Button" parent="Layout/Footer"]
custom_minimum_size = Vector2(220, 48)
layout_mode = 2
text = "START MATCH"

[connection signal="item_selected" from="Layout/Body/Settings/VictoryMode" to="." method="_on_victory_mode_selected"]
[connection signal="value_changed" from="Layout/Body/Settings/VictoryTarget" to="." method="_on_victory_target_changed"]
[connection signal="item_selected" from="Layout/Body/Settings/Visibility" to="." method="_on_visibility_selected"]
[connection signal="value_changed" from="Layout/Body/Settings/StartTimer" to="." method="_on_start_timer_changed"]
[connection signal="value_changed" from="Layout/Body/Settings/MainTimer" to="." method="_on_main_timer_changed"]
[connection signal="value_changed" from="Layout/Body/Settings/HandTimer" to="." method="_on_hand_timer_changed"]
[connection signal="value_changed" from="Layout/Body/Settings/EndTimer" to="." method="_on_end_timer_changed"]
[connection signal="value_changed" from="Layout/Body/Settings/ReconnectTimer" to="." method="_on_reconnect_timer_changed"]
[connection signal="pressed" from="Layout/StatusPanel/RetryButton" to="." method="_on_retry_pressed"]
[connection signal="pressed" from="Layout/StatusPanel/DetailsButton" to="." method="_on_details_pressed"]
[connection signal="pressed" from="Layout/Footer/LeaveButton" to="." method="_on_leave_pressed"]
[connection signal="toggled" from="Layout/Footer/ReadyButton" to="." method="_on_ready_toggled"]
[connection signal="pressed" from="Layout/Footer/StartButton" to="." method="_on_start_pressed"]
