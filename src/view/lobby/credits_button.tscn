[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://src/view/lobby/credits_button.gd" id="1_script"]
[ext_resource type="StyleBox" path="res://themes/shift_panel.tres" id="2_panel"]

[sub_resource type="SystemFont" id="Font_credits"]
font_names = PackedStringArray("Arial", "Liberation Sans", "DejaVu Sans")

[sub_resource type="SystemFont" id="Font_credits_bold"]
font_names = PackedStringArray("Arial", "Liberation Sans", "DejaVu Sans")
font_weight = 700

[node name="CreditsButton" type="Button"]
layout_mode = 1
anchors_preset = 3
anchor_left = 1.0
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = -126.0
offset_top = -48.0
grow_horizontal = 0
grow_vertical = 0
mouse_default_cursor_shape = 2
theme_override_fonts/font = SubResource("Font_credits")
theme_override_font_sizes/font_size = 20
text = "Credits"
script = ExtResource("1_script")

[node name="CreditsDialog" type="AcceptDialog" parent="."]
title = "Credits"
size = Vector2i(660, 530)
visible = false
transient = true
exclusive = true
unresizable = true
ok_button_text = "Close"
theme_override_styles/panel = ExtResource("2_panel")
theme_override_fonts/title_font = SubResource("Font_credits")
theme_override_font_sizes/title_font_size = 22

[node name="Margin" type="MarginContainer" parent="CreditsDialog"]
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 14

[node name="Attribution" type="RichTextLabel" parent="CreditsDialog/Margin"]
layout_mode = 2
theme_override_fonts/normal_font = SubResource("Font_credits")
theme_override_fonts/bold_font = SubResource("Font_credits_bold")
theme_override_font_sizes/normal_font_size = 23
theme_override_font_sizes/bold_font_size = 25
bbcode_enabled = true
text = "[b]Zeitklus: The Cycle of Ages[/b]
Made by anarchira and akts625

[b]Music[/b]
[url=https://www.youtube.com/watch?v=6wMNM0BjJGM]The Epic Hero[/url] by [url=https://www.youtube.com/@KeysofMoonMusic]Serjo De Lua (Keys of Moon Music)[/url]

[b]Sound and ambience[/b]
[url=https://willosuna.itch.io/card-game-sfx-lite]Card Game SFX Lite[/url] by Willosuna
[url=https://jdsherbert.itch.io/tabletop-games-sfx-pack]Tabletop Games Sound Effect Pack[/url] by JDSherbert
[url=https://freesound.org/people/funkysandwich/sounds/871034/]metal_chain_drop2[/url] by funkysandwich
[url=https://freesound.org/people/ldezem/sounds/386174/]Chain pulley 750kg - Chain pull[/url] by ldezem
[url=https://freesound.org/people/RanneM/sounds/475557/]Bip.wav[/url] by Ranne Madsen
[url=https://freesound.org/people/Jacco18/sounds/419023/]acess denied buzz[/url] by Jacco18
Freesound clips licensed under [url=https://creativecommons.org/publicdomain/zero/1.0/]CC0 1.0[/url]

[b]Typeface[/b]
[url=https://www.fontspace.com/mountain-king-font-f119642]Mountain King Regular[/url] by Michael W. Moss ([url=https://creativecommons.org/licenses/by/4.0/]CC BY 4.0[/url])

[b]Technology[/b]
[url=https://godotengine.org/license/]Godot Engine[/url] and [url=https://github.com/godotengine/webrtc-native]Godot WebRTC Native[/url]"

[connection signal="pressed" from="." to="CreditsDialog" method="popup_centered"]
[connection signal="meta_clicked" from="CreditsDialog/Margin/Attribution" to="." method="_on_source_clicked"]
