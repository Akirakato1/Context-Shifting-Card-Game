[ext_resource type="Theme" path="res://themes/placeholder_theme.tres" id="2_theme"]

[node name="AbilityDeckEditor" type="VBoxContainer"]
script = ExtResource("1_script")

[node name="Open" type="Button" parent="."]
layout_mode = 2
text = "Ability Deck"

[node name="DeckDialog" type="ConfirmationDialog" parent="."]
