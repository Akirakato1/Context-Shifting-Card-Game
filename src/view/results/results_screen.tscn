[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://src/view/results/results_screen.gd" id="1_script"]
[ext_resource type="Theme" path="res://themes/placeholder_theme.tres" id="2_theme"]

[node name="ResultsScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_script")

[node name="Backdrop" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.025, 0.045, 0.062, 1)

[node name="Layout" type="VBoxContainer" parent="."]
custom_minimum_size = Vector2(720, 0)
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -360.0
offset_top = -320.0
offset_right = 360.0
offset_bottom = 320.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 16

[node name="Eyebrow" type="Label" parent="Layout"]
layout_mode = 2
theme_override_colors/font_color = Color(0.35, 0.78, 0.93, 1)
text = "MATCH COMPLETE"
horizontal_alignment = 1

[node name="Title" type="Label" parent="Layout"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.82, 0.38, 1)
theme_override_font_sizes/font_size = 48
text = "MATCH ENDED"
horizontal_alignment = 1

[node name="Summary" type="Label" parent="Layout"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "Final result"
horizontal_alignment = 1
autowrap_mode = 2

[node name="NilNote" type="Label" parent="Layout"]
visible = false
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.65, 0.45, 1)
text = "The previous round was nil; no progress was awarded."
horizontal_alignment = 1

[node name="StandingsHeading" type="Label" parent="Layout"]
layout_mode = 2
theme_override_colors/font_color = Color(0.66, 0.74, 0.82, 1)
text = "FINAL STANDINGS"
horizontal_alignment = 1

[node name="Standings" type="VBoxContainer" parent="Layout"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 8

[node name="Room" type="Label" parent="Layout"]
layout_mode = 2
theme_override_colors/font_color = Color(0.45, 0.76, 0.91, 1)
text = "ROOM ------  ·  occupants stay together for a rematch"
horizontal_alignment = 1

[node name="Waiting" type="Label" parent="Layout"]
visible = false
layout_mode = 2
text = "Waiting for the host…"
horizontal_alignment = 1

[node name="Actions" type="HBoxContainer" parent="Layout"]
layout_mode = 2
alignment = 1
theme_override_constants/separation = 12

[node name="MenuButton" type="Button" parent="Layout/Actions"]
visible = false
custom_minimum_size = Vector2(190, 48)
layout_mode = 2
text = "RETURN TO MENU"

[node name="LobbyButton" type="Button" parent="Layout/Actions"]
custom_minimum_size = Vector2(190, 48)
layout_mode = 2
text = "RETURN TO LOBBY"

[node name="RematchButton" type="Button" parent="Layout/Actions"]
custom_minimum_size = Vector2(190, 48)
layout_mode = 2
text = "START REMATCH"

[connection signal="pressed" from="Layout/Actions/MenuButton" to="." method="_on_menu_pressed"]
[connection signal="pressed" from="Layout/Actions/LobbyButton" to="." method="_on_lobby_pressed"]
[connection signal="pressed" from="Layout/Actions/RematchButton" to="." method="_on_rematch_pressed"]
